{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 8,
    },
  },
  "modules": [
    {
      "type": "os",
      "key": "{#31}os",
      "keyColor": "31",
    },
    {
      "type": "shell",
      "key": "{#33}sh",
      "keyColor": "33",
    },
    {
      "type": "terminal",
      "key": "{#34}term",
      "keyColor": "34",
    },
    {
      "type": "packages",
      "key": "{#35}pkg",
      "keyColor": "35",
    },
    {
      "type": "wm",
      "key": "{#36}wm",
      "keyColor": "36",
    },
  ],
}
